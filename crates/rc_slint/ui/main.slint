// The font of the app, which the QML app ships too. Loading it registers its families.
import "../../../src/gui/fonts/InstrumentSans.ttf";
import "../../../src/gui/fonts/InstrumentSans-Italic.ttf";

import { ConfirmDialog } from "confirm_dialog.slint";
import { LoginPage } from "login_page.slint";
import { RoomPage } from "room_page.slint";
import { ServerRail } from "server_rail.slint";
import { StartupPage } from "startup_page.slint";
import { AccountTile, LoginMode, MessageMenu, MessageRow, RoomRow, RoomSection, SessionStatus } from "structs.slint";
import { Theme } from "theme.slint";

// The theme, for Rust: the colours it writes into rich text.
export { AccountTile, LoginMode, MessageRow, RoomRow, RoomSection, SessionStatus, Theme }

export component MainWindow inherits Window {
    // The version of the app, set from Rust (`rc_core::VERSION`).
    in property <string> version;

    // The session of the account on screen: the values of `rc_view::session_view::SessionView`.
    in property <SessionStatus> status: SessionStatus.unknown;
    in property <bool> busy;
    in property <string> error-text;
    in property <string> username;
    // The server without its scheme or path.
    in property <string> host;
    // Empty while the realtime connection is up.
    in property <string> connection-text;
    in property <string> account-id;
    in property <LoginMode> login-mode;
    in property <string> login-title;
    in property <string> login-lede;
    in property <string> login-notice;
    in property <string> login-server;
    in property <string> login-username;
    // What the password field starts with: empty, unless a developer-mode build got `--dev`.
    in property <string> prefill-password;

    // The rail of servers.
    in property <[AccountTile]> tiles;
    in property <bool> has-new-account;

    // The room list, and the open room.
    in property <[RoomRow]> rooms;
    in property <string> room-id;
    in property <string> room-name;
    in property <string> room-kind;
    // The topic as styled text, and as the HTML that the GUI tests read.
    in property <styled-text> room-topic;
    in property <string> room-topic-html;
    in property <string> typing;
    // The open room's messages, oldest first, and the state of its list (see `message_list.slint`).
    in property <[MessageRow]> messages;
    in property <bool> reached-start;
    in property <bool> loading-older;
    in property <int> prepends;
    in property <int> resets;

    callback login(string, string, string);
    // Removes the account on screen: Cancel, Remove this server and Log out in the settings menu.
    callback logout();
    callback select-account(string);
    callback add-account();
    callback remove-account(string);
    // Why the last command on a room failed; empty for none.
    in property <string> room-list-error;
    // The room search: whether the query isn't empty, and then the query without the space around
    // it and the rooms that match it (worst first), with a number that goes up with each result
    // set.
    in property <bool> search-active;
    in property <string> search-trimmed;
    in property <[RoomRow]> search-results;
    in property <int> search-generation;
    // The text of the search field changed.
    callback search(string);
    callback open-room(string);
    // The room's menu: a favorite is set or taken back, the room is marked read or unread, the
    // user confirmed leaving it, or dismissed the error.
    callback set-favorite(string, bool);
    callback mark-read(string);
    callback mark-unread(string);
    callback leave-room(string);
    callback dismiss-room-list-error();
    // Why the last edit or deletion of a message failed; empty for none.
    in property <string> room-action-error;
    callback dismiss-room-action-error();
    // The menu of a message asks what it offers when it opens; the user confirmed deleting a
    // message.
    callback menu-allowed(string) -> MessageMenu;
    callback delete-message(string);
    // The composer edits a message: it asks for the text of one and for the newest the user can
    // edit, and saves a new text. The answer to the last save is the counter, the message and
    // whether it worked.
    callback message-text(string) -> string;
    callback last-editable() -> string;
    callback save-edit(string, string);
    in property <int> edit-answers;
    in property <string> edit-answer-id;
    in property <bool> edit-answer-ok;
    // The list of messages is at its top: older ones are wanted.
    callback load-older();
    // Opens the address of a link of a text in the browser.
    callback open-link(string);
    // Sends the text to the open room; false if it refuses it (blank), which keeps the composer's.
    callback send(string) -> bool;
    callback retry(string);
    // Logs what Slint knows about the display.
    callback dump-info();

    // The room that leaving was asked for, until the user answers: its id, and its name for the
    // dialog.
    property <string> leaving-id;
    property <string> leaving-name;
    // The message that deleting was asked for, until the user answers.
    property <string> deleting-id;

    title: @tr("RocketChatQml");
    background: Theme.base;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-base;
    default-font-weight: Theme.font-weight-normal;
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;

    // The rail of servers is at the left of every page, except while the session state is unknown:
    // until the core has said what the account is doing, there is nothing to put in it. It shows
    // beside the startup page of a resume, so that the tile of the account shows its ring.
    rail := ServerRail {
        x: Theme.spacing-none;
        y: Theme.spacing-none;
        height: parent.height;
        visible: root.status != SessionStatus.unknown;
        z: Theme.z-above;
        tiles: root.tiles;
        has-new: root.has-new-account;
        select-account(id) => {
            root.select-account(id);
        }
        add-account => {
            root.add-account();
        }
        remove-account(id) => {
            root.remove-account(id);
        }
        logout => {
            root.logout();
        }
        dump-info => {
            root.dump-info();
        }
    }

    // One page per session state, in the space right of the rail. While logging in the state is
    // Connecting, which keeps the login page and its fields. Resuming a stored session at startup
    // shows the startup page, so that the login page doesn't flash before the room list.
    page := Rectangle {
        x: rail.visible ? rail.width : Theme.spacing-none;
        y: Theme.spacing-none;
        width: parent.width - self.x;
        height: parent.height;

        if root.status == SessionStatus.logged-in: RoomPage {
            connection-text: root.connection-text;
            host: root.host;
            username: root.username;
            rooms: root.rooms;
            room-id: root.room-id;
            room-name: root.room-name;
            room-kind: root.room-kind;
            room-topic: root.room-topic;
            room-topic-html: root.room-topic-html;
            typing: root.typing;
            room-list-error: root.room-list-error;
            room-action-error: root.room-action-error;
            edit-answers: root.edit-answers;
            edit-answer-id: root.edit-answer-id;
            edit-answer-ok: root.edit-answer-ok;
            search-active: root.search-active;
            search-trimmed: root.search-trimmed;
            search-results: root.search-results;
            search-generation: root.search-generation;
            messages: root.messages;
            reached-start: root.reached-start;
            loading-older: root.loading-older;
            prepends: root.prepends;
            resets: root.resets;
            search(query) => {
                root.search(query);
            }
            open-room(id) => {
                root.open-room(id);
            }
            set-favorite(id, favorite) => {
                root.set-favorite(id, favorite);
            }
            mark-read(id) => {
                root.mark-read(id);
            }
            mark-unread(id) => {
                root.mark-unread(id);
            }
            leave(id, name) => {
                root.leaving-id = id;
                root.leaving-name = name;
            }
            dismiss-room-list-error => {
                root.dismiss-room-list-error();
            }
            dismiss-room-action-error => {
                root.dismiss-room-action-error();
            }
            menu-allowed(id) => {
                return root.menu-allowed(id);
            }
            delete-message(id) => {
                root.deleting-id = id;
            }
            message-text(id) => {
                return root.message-text(id);
            }
            last-editable => {
                return root.last-editable();
            }
            save-edit(id, text) => {
                root.save-edit(id, text);
            }
            load-older => {
                root.load-older();
            }
            open-link(url) => {
                root.open-link(url);
            }
            send(text) => {
                return root.send(text);
            }
            retry(id) => {
                root.retry(id);
            }
        }

        if root.status == SessionStatus.unknown || root.status == SessionStatus.resuming: StartupPage {
            version: root.version;
        }

        if root.status == SessionStatus.logged-out || root.status == SessionStatus.connecting: LoginPage {
            version: root.version;
            login-mode: root.login-mode;
            login-title: root.login-title;
            login-lede: root.login-lede;
            login-notice: root.login-notice;
            login-server: root.login-server;
            login-username: root.login-username;
            prefill-password: root.prefill-password;
            error-text: root.error-text;
            busy: root.busy;
            account-id: root.account-id;
            login(server, username, password) => {
                root.login(server, username, password);
            }
            logout => {
                root.logout();
            }
        }
    }

    // Over everything, the rail included.
    if !root.leaving-id.is-empty: ConfirmDialog {
        x: Theme.spacing-none;
        y: Theme.spacing-none;
        width: parent.width;
        height: parent.height;
        z: Theme.z-modal;
        title: @tr("Leave room");
        question: @tr("Leave {}?", root.leaving-name);
        confirm-text: @tr("Leave");
        question-id: "roomLeaveDialog";
        confirm-id: "roomLeaveConfirm";
        cancel-id: "roomLeaveCancel";
        confirmed => {
            root.leave-room(root.leaving-id);
            root.leaving-id = "";
        }
        cancelled => {
            root.leaving-id = "";
        }
    }

    if !root.deleting-id.is-empty: ConfirmDialog {
        x: Theme.spacing-none;
        y: Theme.spacing-none;
        width: parent.width;
        height: parent.height;
        z: Theme.z-modal;
        title: @tr("Delete message");
        question: @tr("Delete this message for everyone? This can't be undone.");
        confirm-text: @tr("Delete");
        question-id: "deleteDialog";
        confirm-id: "deleteConfirm";
        cancel-id: "deleteCancel";
        confirmed => {
            root.delete-message(root.deleting-id);
            root.deleting-id = "";
        }
        cancelled => {
            root.deleting-id = "";
        }
    }
}
