// SPDX-FileCopyrightText: 2026 Sergio Martins
// SPDX-License-Identifier: MIT

import { Avatar } from "avatar.slint";
import { Icon } from "icon.slint";
import { FlatButton } from "flat_button.slint";
import { MenuItem } from "menu_item.slint";
import { MessageMenu, MessageRow, QuoteRow, ReactionRow } from "structs.slint";
import { Theme } from "theme.slint";

// One message of the open room, named `msg_<id>` by its message id. Its parts are named like the Qt
// app's: `msgDaySeparator` (on the first message of a day), `msgAvatar`, `msgAuthor`, `msgTime`,
// `msgMentionsMe`, `msgBody` (the message as written, holding `msgBodyHtml`, what is shown),
// `msgReactions` (the chips, shown when there are reactions: `reaction<index>`, which is checked
// when the user reacted, holding `reactionEmoji` and `reactionCount`), and `msgSystem` for a system
// message, which has no author and no body. A message with a menu has the button `msgMenuButton`,
// clear until the pointer is over the message; it and a right-click on the message open the menu,
// whose items are popups, found from the window by their names while it is open.
export component MessageDelegate inherits Rectangle {
    in property <MessageRow> message;
    // The row is in the thread pane and not in the room: it has no thread of its own to start, no
    // summary and no line to the thread it is in; under the parent it draws the divider that says
    // how many replies follow.
    in property <bool> in-thread-pane;
    // The parent of the thread that is open beside the room, empty for none.
    in property <string> open-thread-id;
    // Opens the thread of the message with this id: from its summary or its menu, or from the line
    // of a reply that leads to its parent.
    callback open-thread(string);
    // A link of the body was clicked.
    callback open-link(string);
    // The id of a message that failed to send, to send again.
    callback retry(string);
    // What the menu of the message (by its id) offers now, asked when it opens.
    callback menu-allowed(string) -> MessageMenu;
    // The menu's commands. Deleting is only asked for: the page asks the user first.
    callback quote(string);
    callback edit(string);
    callback delete(string);
    // The user clicked a chip: add their reaction with the emoji (the shortcode), or take it back.
    callback react(string, string, bool);
    // The user wants to pick an emoji to react to the message (by its id) with: from the menu, the
    // "+" chip or a double-click.
    callback add-reaction(string);

    // The width that wrapped texts have: the row's, less the space around them. Given explicitly,
    // since a wrapped text can't tell its height from the width a layout will give it.
    property <length> text-width: root.width - 2 * Theme.spacing-xxxl;
    property <length> body-width: root.text-width - Theme.avatar-size - Theme.spacing-xxl;
    // What a quote's text has: the body's, less its bar and the space after it.
    property <length> quote-width: root.body-width - Theme.quote-bar-width - Theme.spacing-xxl;

    // What the menu offers, as of when it was opened; and where it opens, in the message's own
    // coordinates.
    property <bool> can-quote;
    property <bool> can-react;
    property <bool> can-edit;
    property <bool> can-delete;
    property <length> menu-x;
    property <length> menu-y;
    // The pointer is over a chip, which takes it from the row behind: the "+" stays.
    property <bool> over-chip;
    // The message is the parent of the thread beside the room.
    property <bool> thread-open: !root.in-thread-pane && root.message.id == root.open-thread-id;

    // Opens the menu at `x`, `y` unless it would be empty.
    function open-menu(x: length, y: length) {
        if !root.message.has-menu {
            return;
        }
        let allowed = root.menu-allowed(root.message.id);
        root.can-quote = allowed.can-quote;
        root.can-react = allowed.can-react;
        root.can-edit = allowed.can-edit;
        root.can-delete = allowed.can-delete;
        if root.message.can-start-thread || allowed.can-quote || allowed.can-react || allowed.can-edit || allowed.can-delete {
            root.menu-x = x;
            root.menu-y = y;
            menu.show();
        }
    }

    accessible-role: list-item;
    accessible-id: "msg_" + root.message.id;
    preferred-height: column.preferred-height;

    column := VerticalLayout {
        padding: Theme.spacing-none;
        spacing: Theme.spacing-xs;

        // A heading above the first message of each day.
        if root.message.first-of-day: HorizontalLayout {
            padding-left: Theme.spacing-xxxl;
            padding-right: Theme.spacing-xxxl;
            padding-top: Theme.spacing-xxxl;
            padding-bottom: Theme.spacing-l;
            spacing: Theme.spacing-xxl;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.separator-width;
                background: Theme.line;
            }

            Text {
                accessible-id: "msgDaySeparator";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                font-weight: Theme.font-weight-semibold;
                text: root.message.day-label;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.separator-width;
                background: Theme.line;
            }
        }

        if !root.message.is-system: Rectangle {
            preferred-height: content.preferred-height;

            // A faint tint and no edge, which means "about you": the thread of this message is open.
            if root.thread-open: Rectangle {
                accessible-id: "msgThreadOpen";
                accessible-role: text;
                accessible-label: @tr("Its thread is open");
                background: Theme.own-tint;
            }

            // The row washed in the colour of mentions, and an edge at its left.
            if root.message.mentions-me: Rectangle {
                accessible-id: "msgMentionsMe";
                accessible-role: text;
                accessible-label: @tr("Mentions you");
                background: Theme.signal-wash;

                Rectangle {
                    x: Theme.spacing-none;
                    width: Theme.accent-bar-width;
                    background: Theme.signal;
                }
            }

            // Behind the message, so that what is on it takes its own clicks.
            row-touch := TouchArea {
                double-clicked => {
                    if root.message.can-react {
                        root.add-reaction(root.message.id);
                    }
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                        root.open-menu(self.absolute-position.x + self.mouse-x - root.absolute-position.x, self.absolute-position.y + self.mouse-y - root.absolute-position.y);
                    }
                }
            }

            content := HorizontalLayout {
                padding-left: Theme.spacing-xxxl;
                padding-right: Theme.spacing-xxxl;
                padding-top: Theme.message-padding-v;
                padding-bottom: Theme.message-padding-v;
                spacing: Theme.spacing-xxl;

                VerticalLayout {
                    alignment: start;
                    width: Theme.avatar-size;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    Avatar {
                        width: Theme.avatar-size;
                        height: Theme.avatar-size;
                        source: root.message.avatar;
                        has-image: root.message.has-avatar;
                        url: root.message.avatar-url;
                        initials: root.message.initials;
                        fill-color: root.message.initials-color;
                        image-name: "msgAvatar";
                        placeholder-name: "msgAvatarPlaceholder";
                        initials-name: "msgAvatarInitials";
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-xs;

                    HorizontalLayout {
                        padding: Theme.spacing-none;
                        spacing: Theme.spacing-l;

                        Text {
                            accessible-id: "msgAuthor";
                            // For the GUI tests: Slint's testing API can't tell whether a Text is
                            // elided, so spix_slint reads it from the description.
                            accessible-description: self.preferred-width > self.width
                                ? "truncated" : "";
                            vertical-alignment: center;
                            color: Theme.text;
                            font-weight: Theme.font-weight-semibold;
                            overflow: elide;
                            text: root.message.author;
                        }

                        Text {
                            accessible-id: "msgTime";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: root.message.time;
                        }

                        if root.message.edited: Text {
                            accessible-id: "msgEdited";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: @tr("(edited)");
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        // Keeps its place the rest of the time, so the rows don't change height.
                        VerticalLayout {
                            alignment: center;
                            width: Theme.menu-button-width;
                            padding: Theme.spacing-none;
                            spacing: Theme.spacing-none;

                            menu-button := Rectangle {
                                accessible-id: "msgMenuButton";
                                accessible-role: button;
                                accessible-label: @tr("Message menu");
                                visible: root.message.has-menu;
                                height: Theme.menu-button-height;
                                opacity: row-touch.has-hover || button-touch.has-hover || menu.is-open ? Theme.opaque : Theme.clear;
                                background: Theme.raised;
                                border-color: Theme.raised-hover;
                                border-width: Theme.border-width;
                                border-radius: Theme.radius-control;

                                Text {
                                    color: button-touch.has-hover ? Theme.text : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: "\u{22EF}";
                                }

                                button-touch := TouchArea {
                                    clicked => {
                                        root.open-menu(menu-button.absolute-position.x - root.absolute-position.x, menu-button.absolute-position.y - root.absolute-position.y + menu-button.height);
                                    }
                                }
                            }
                        }

                        // These exist only while the message is in that state, so that a test can
                        // find the one unsent message without knowing its id.
                        if root.message.delivery == "pending": Text {
                            accessible-id: "msgPending";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: @tr("Sending…");
                        }

                        if root.message.delivery == "failed": Text {
                            accessible-id: "msgFailed";
                            vertical-alignment: center;
                            color: Theme.error;
                            font-size: Theme.font-size-tiny;
                            text: @tr("Not sent");
                        }

                        if root.message.delivery == "failed": FlatButton {
                            accessible-id: "msgRetry";
                            text: @tr("Retry");
                            clicked => {
                                root.retry(root.message.id);
                            }
                        }
                    }

                    // A reply that was also sent to the room says where it belongs, and leads there.
                    // `accessible-value` is what is shown, which the tests read.
                    if root.message.in-thread-shown: Rectangle {
                        accessible-id: "msgInThread";
                        accessible-role: button;
                        accessible-value: in-thread-text.text;
                        accessible-action-default => {
                            root.open-thread(root.message.thread-id);
                        }
                        preferred-height: in-thread-row.preferred-height;

                        in-thread-row := HorizontalLayout {
                            padding: Theme.spacing-none;
                            spacing: Theme.spacing-m;

                            VerticalLayout {
                                alignment: center;
                                width: Theme.in-thread-icon-size;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-none;

                                Icon {
                                    width: Theme.in-thread-icon-size;
                                    height: Theme.in-thread-icon-size;
                                    source: @image-url("../../../src/gui/icons/corner.svg");
                                    tint: in-thread-touch.has-hover ? Theme.own : Theme.text-faint;
                                }
                            }

                            in-thread-text := Text {
                                horizontal-stretch: 1;
                                color: in-thread-touch.has-hover ? Theme.own : Theme.text-faint;
                                font-size: Theme.font-size-small;
                                overflow: elide;
                                text: root.message.thread-parent-text == "" ? @tr("Replied in a thread") : @tr("Replied in a thread: {}", root.message.thread-parent-text);
                            }
                        }

                        in-thread-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.open-thread(root.message.thread-id);
                            }
                        }
                    }

                    // The messages this one quotes, above what it says: a bar down the left, who
                    // said it and when, and what it said. `quoteBody` has the text as written,
                    // which the tests read; `quoteBodyHtml` is what is shown.
                    for quote[index] in root.message.quotes: Rectangle {
                        accessible-id: "quote" + index;
                        accessible-role: groupbox;
                        preferred-height: quote-row.preferred-height;

                        quote-row := HorizontalLayout {
                            padding: Theme.spacing-none;
                            spacing: Theme.spacing-xxl;

                            Rectangle {
                                width: Theme.quote-bar-width;
                                background: Theme.raised-hover;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-xxs;

                                HorizontalLayout {
                                    padding: Theme.spacing-none;
                                    spacing: Theme.spacing-m;

                                    Text {
                                        accessible-id: "quoteAuthor";
                                        color: Theme.text;
                                        font-size: Theme.font-size-small;
                                        font-weight: Theme.font-weight-semibold;
                                        overflow: elide;
                                        text: quote.author;
                                    }

                                    Text {
                                        accessible-id: "quoteTime";
                                        vertical-alignment: center;
                                        color: Theme.text-faint;
                                        font-size: Theme.font-size-tiny;
                                        text: quote.time;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                Rectangle {
                                    accessible-id: "quoteBody";
                                    accessible-role: text;
                                    accessible-value: quote.body;
                                    preferred-height: quote-text.preferred-height;

                                    quote-text := StyledText {
                                        accessible-id: "quoteBodyHtml";
                                        accessible-role: text;
                                        accessible-value: quote.body-html;
                                        x: Theme.spacing-none;
                                        y: Theme.spacing-none;
                                        width: root.quote-width;
                                        default-color: Theme.text-muted;
                                        default-font-size: Theme.font-size-small;
                                        link-color: Theme.own;
                                        text: quote.body-styled;
                                        link-clicked(url) => {
                                            root.open-link(url);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // `accessible-value` is the message as written, which the tests read;
                    // `msgBodyHtml` is what is shown. Hidden when a message of only quotes has no
                    // text to leave a blank line for.
                    if !root.message.body.is-empty || root.message.quotes.length == 0: Rectangle {
                        accessible-id: "msgBody";
                        accessible-role: text;
                        accessible-value: root.message.body;
                        opacity: root.message.delivery == "sent" ? Theme.opaque : Theme.disabled-opacity;
                        preferred-height: body-text.preferred-height;

                        body-text := StyledText {
                            accessible-id: "msgBodyHtml";
                            accessible-role: text;
                            accessible-value: root.message.body-html;
                            x: Theme.spacing-none;
                            y: Theme.spacing-none;
                            width: root.body-width;
                            default-color: Theme.text;
                            default-font-size: root.message.big-emoji ? Theme.font-size-big-emoji : Theme.font-size-base;
                            link-color: Theme.own;
                            text: root.message.body-styled;
                            link-clicked(url) => {
                                root.open-link(url);
                            }
                        }

                        // The text takes every click, not only those on its links, so the message
                        // behind never sees a double-click on it. Without links there is nothing to
                        // click on, and this takes the double-click instead. (With links, the text
                        // beside it still works.)
                        if !root.message.has-links: TouchArea {
                            double-clicked => {
                                if root.message.can-react {
                                    root.add-reaction(root.message.id);
                                }
                            }
                        }
                    }

                    // What users reacted with: a chip for each emoji, in the server's order, with
                    // its count, marked when the user is one of them. The chips wrap. A click
                    // takes the user's reaction back or joins the others in it, if the message
                    // can be reacted to.
                    if root.message.reactions.length > 0: Rectangle {
                        accessible-id: "msgReactions";
                        accessible-role: groupbox;
                        min-height: chips.preferred-height;
                        preferred-height: chips.preferred-height;

                        chips := FlexboxLayout {
                            padding: Theme.spacing-none;
                            spacing: Theme.spacing-m;

                            for reaction[index] in root.message.reactions: Rectangle {
                                accessible-id: "reaction" + index;
                                accessible-role: checkbox;
                                accessible-checkable: true;
                                accessible-checked: reaction.mine;
                                width: chip-row.preferred-width + Theme.chip-padding;
                                height: Theme.chip-height;
                                background: reaction.mine ? Theme.own-wash : Theme.raised;
                                border-color: reaction.mine ? Theme.own-border : chip-touch.has-hover ? Theme.raised-hover : Theme.transparent;
                                border-width: Theme.border-width;
                                border-radius: self.height / 2;

                                chip-row := HorizontalLayout {
                                    alignment: center;
                                    cross-axis-alignment: center;
                                    padding: Theme.spacing-none;
                                    spacing: Theme.spacing-s;

                                    // `accessible-value` is what the tests read: the glyph, else
                                    // the address of the custom emoji's image, else the shortcode.
                                    Rectangle {
                                        accessible-id: "reactionEmoji";
                                        accessible-role: text;
                                        accessible-value: reaction.label;
                                        width: reaction.has-image ? Theme.chip-emoji-size : emoji-text.preferred-width;
                                        height: Theme.chip-emoji-size;

                                        if reaction.has-image: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: reaction.image;
                                            image-fit: contain;
                                        }

                                        emoji-text := Text {
                                            visible: !reaction.has-image;
                                            vertical-alignment: center;
                                            text: reaction.text;
                                        }
                                    }

                                    Text {
                                        accessible-id: "reactionCount";
                                        accessible-role: text;
                                        vertical-alignment: center;
                                        color: reaction.mine ? Theme.own : Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        font-weight: Theme.font-weight-semibold;
                                        text: reaction.count;
                                    }
                                }

                                chip-touch := TouchArea {
                                    changed has-hover => {
                                        root.over-chip = self.has-hover;
                                    }
                                    mouse-cursor: root.message.can-react ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        if root.message.can-react {
                                            root.react(root.message.id, reaction.emoji, !reaction.mine);
                                        }
                                    }
                                }
                            }

                            // Another emoji of the user's choosing. It keeps its place, clear until
                            // the pointer is over the message, so the chips don't move.
                            if root.message.can-react: Rectangle {
                                accessible-id: "reactionAdd";
                                accessible-role: button;
                                accessible-label: @tr("Add reaction");
                                width: Theme.chip-add-width;
                                height: Theme.chip-height;
                                opacity: row-touch.has-hover || root.over-chip || add-touch.has-hover ? Theme.opaque : Theme.clear;
                                background: Theme.raised;
                                border-color: add-touch.has-hover ? Theme.raised-hover : Theme.transparent;
                                border-width: Theme.border-width;
                                border-radius: self.height / 2;

                                Text {
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: "+";
                                }

                                add-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.add-reaction(root.message.id);
                                    }
                                }
                            }
                        }
                    }

                    // The thread this message starts: how many replies it has and when the last
                    // came. Clicking opens it beside the room. While it is open the button is
                    // washed in the colour of what is the user's.
                    if root.message.thread-replies > 0 && !root.in-thread-pane: HorizontalLayout {
                        alignment: start;
                        padding-left: Theme.spacing-none;
                        padding-right: Theme.spacing-none;
                        padding-top: Theme.spacing-m;
                        padding-bottom: Theme.spacing-none;
                        spacing: Theme.spacing-none;

                        Rectangle {
                            accessible-id: "msgThreadSummary";
                            accessible-role: button;
                            accessible-label: summary-count.text;
                            accessible-action-default => {
                                root.open-thread(root.message.id);
                            }
                            width: summary-row.preferred-width + 2 * Theme.spacing-xl;
                            height: Theme.thread-summary-height;
                            background: root.thread-open ? Theme.own-wash : summary-touch.has-hover ? Theme.raised : Theme.transparent;
                            border-color: root.thread-open ? Theme.own-border : summary-touch.has-hover ? Theme.raised-hover : Theme.transparent;
                            border-width: Theme.border-width;
                            border-radius: Theme.radius-control;

                            summary-row := HorizontalLayout {
                                x: Theme.spacing-xl;
                                width: self.preferred-width;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-l;

                                VerticalLayout {
                                    alignment: center;
                                    width: Theme.thread-summary-icon-size;
                                    padding: Theme.spacing-none;
                                    spacing: Theme.spacing-none;

                                    Icon {
                                        width: Theme.thread-summary-icon-size;
                                        height: Theme.thread-summary-icon-size;
                                        source: @image-url("../../../src/gui/icons/thread.svg");
                                        tint: Theme.own;
                                    }
                                }

                                summary-count := Text {
                                    accessible-id: "msgThreadCount";
                                    vertical-alignment: center;
                                    color: Theme.own;
                                    font-size: Theme.font-size-small;
                                    font-weight: Theme.font-weight-bold;
                                    text: @tr("{n} reply" | "{n} replies" % root.message.thread-replies);
                                }

                                if root.message.thread-last-reply != "": Text {
                                    accessible-id: "msgThreadLastReply";
                                    vertical-alignment: center;
                                    color: Theme.text-faint;
                                    font-size: Theme.font-size-tiny;
                                    text: @tr("Last reply {}", root.message.thread-last-reply);
                                }
                            }

                            summary-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.open-thread(root.message.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Under the parent in the thread pane: how many replies follow.
        if root.in-thread-pane && root.message.thread-replies > 0: HorizontalLayout {
            padding-left: Theme.spacing-xxxl;
            padding-right: Theme.spacing-xxxl;
            padding-top: Theme.spacing-xxl;
            padding-bottom: Theme.spacing-xs;
            spacing: Theme.spacing-xxl;

            Text {
                accessible-id: "threadReplies";
                vertical-alignment: center;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                font-weight: Theme.font-weight-semibold;
                text: @tr("{n} reply" | "{n} replies" % root.message.thread-replies);
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                padding: Theme.spacing-none;
                spacing: Theme.spacing-none;

                Rectangle {
                    height: Theme.separator-width;
                    background: Theme.line;
                }
            }
        }

        if root.message.is-system: HorizontalLayout {
            padding-left: Theme.spacing-xxxl;
            padding-right: Theme.spacing-xxxl;
            padding-top: Theme.message-padding-v;
            padding-bottom: Theme.message-padding-v;
            spacing: Theme.spacing-l;

            Text {
                accessible-id: "msgSystem";
                width: root.text-width - system-time.preferred-width - Theme.spacing-l;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
                text: root.message.system-text;
            }

            system-time := Text {
                color: Theme.text-faint;
                font-size: Theme.font-size-tiny;
                text: root.message.time;
            }
        }
    }

    // Opens at the pointer or under the button; Slint keeps it inside the window. The items
    // that don't apply are hidden with no height and not left out with `if`, which a click
    // would miss (SLINT.md). Quote, reaction and thread items go above Edit.
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: Theme.menu-width;
        height: items.preferred-height + 2 * Theme.border-width;

        Rectangle {
            background: Theme.raised;
            border-color: Theme.raised-hover;
            border-width: Theme.border-width;
            border-radius: Theme.radius-control;

            items := VerticalLayout {
                padding: Theme.menu-padding;
                spacing: Theme.spacing-none;

                MenuItem {
                    accessible-id: "msgThreadAction";
                    visible: root.message.can-start-thread;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Reply in thread");
                    triggered => {
                        menu.close();
                        root.open-thread(root.message.id);
                    }
                }

                MenuItem {
                    accessible-id: "msgQuoteAction";
                    visible: root.can-quote;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Quote");
                    triggered => {
                        menu.close();
                        root.quote(root.message.id);
                    }
                }

                MenuItem {
                    accessible-id: "msgReactAction";
                    visible: root.can-react;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Add reaction");
                    triggered => {
                        menu.close();
                        root.add-reaction(root.message.id);
                    }
                }

                MenuItem {
                    accessible-id: "msgEditAction";
                    visible: root.can-edit;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Edit");
                    triggered => {
                        menu.close();
                        root.edit(root.message.id);
                    }
                }

                MenuItem {
                    accessible-id: "msgDeleteAction";
                    visible: root.can-delete;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Delete");
                    triggered => {
                        menu.close();
                        root.delete(root.message.id);
                    }
                }
            }
        }
    }
}
