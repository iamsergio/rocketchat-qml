import { Avatar } from "avatar.slint";
import { FlatButton } from "flat_button.slint";
import { MenuItem } from "menu_item.slint";
import { MessageMenu, MessageRow } from "structs.slint";
import { Theme } from "theme.slint";

// One message of the open room, named `msg_<id>` by its message id. Its parts are named like the
// Qt app's: `msgDaySeparator` (on the first message of a day), `msgAvatar`, `msgAuthor`, `msgTime`,
// `msgMentionsMe`, `msgBody` (the message as written, holding `msgBodyHtml`, what is shown), and
// `msgSystem` for a system message, which has no author and no body. A message with a menu has the
// button `msgMenuButton`, clear until the pointer is over the message; it and a right-click on the
// message open the menu, whose items are popups, found from the window by their names while it is
// open.
export component MessageDelegate inherits Rectangle {
    in property <MessageRow> message;
    // A link of the body was clicked.
    callback open-link(string);
    // The id of a message that failed to send, to send again.
    callback retry(string);
    // What the menu of the message (by its id) offers now, asked when it opens.
    callback menu-allowed(string) -> MessageMenu;
    // The menu's commands. Deleting is only asked for: the page asks the user first.
    callback edit(string);
    callback delete(string);

    // The width that wrapped texts have: the row's, less the space around them. Given explicitly,
    // since a wrapped text can't tell its height from the width a layout will give it.
    property <length> text-width: root.width - 2 * Theme.spacing-xxxl;
    property <length> body-width: root.text-width - Theme.avatar-size - Theme.spacing-xxl;

    // What the menu offers, as of when it was opened; and where it opens, in the message's own
    // coordinates.
    property <bool> can-edit;
    property <bool> can-delete;
    property <length> menu-x;
    property <length> menu-y;

    // Opens the menu at `x`, `y` unless it would be empty.
    function open-menu(x: length, y: length) {
        if !root.message.has-menu {
            return;
        }
        let allowed = root.menu-allowed(root.message.id);
        root.can-edit = allowed.can-edit;
        root.can-delete = allowed.can-delete;
        if allowed.can-edit || allowed.can-delete {
            root.menu-x = x;
            root.menu-y = y;
            menu.show();
        }
    }

    accessible-role: list-item;
    accessible-id: "msg_" + root.message.id;
    preferred-height: column.preferred-height;

    column := VerticalLayout {
        padding: Theme.spacing-none;
        spacing: Theme.spacing-xs;

        // A heading above the first message of each day.
        if root.message.first-of-day: HorizontalLayout {
            padding-left: Theme.spacing-xxxl;
            padding-right: Theme.spacing-xxxl;
            padding-top: Theme.spacing-xxxl;
            padding-bottom: Theme.spacing-l;
            spacing: Theme.spacing-xxl;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.separator-width;
                background: Theme.line;
            }

            Text {
                accessible-id: "msgDaySeparator";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                font-weight: Theme.font-weight-semibold;
                text: root.message.day-label;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.separator-width;
                background: Theme.line;
            }
        }

        if !root.message.is-system: Rectangle {
            preferred-height: content.preferred-height;

            // The row washed in the colour of mentions, and an edge at its left.
            if root.message.mentions-me: Rectangle {
                accessible-id: "msgMentionsMe";
                accessible-role: text;
                accessible-label: @tr("Mentions you");
                background: Theme.signal-wash;

                Rectangle {
                    x: Theme.spacing-none;
                    width: Theme.accent-bar-width;
                    background: Theme.signal;
                }
            }

            // Behind the message, so that what is on it takes its own clicks.
            row-touch := TouchArea {
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                        root.open-menu(self.absolute-position.x + self.mouse-x - root.absolute-position.x, self.absolute-position.y + self.mouse-y - root.absolute-position.y);
                    }
                }
            }

            content := HorizontalLayout {
                padding-left: Theme.spacing-xxxl;
                padding-right: Theme.spacing-xxxl;
                padding-top: Theme.message-padding-v;
                padding-bottom: Theme.message-padding-v;
                spacing: Theme.spacing-xxl;

                VerticalLayout {
                    alignment: start;
                    width: Theme.avatar-size;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    Avatar {
                        width: Theme.avatar-size;
                        height: Theme.avatar-size;
                        source: root.message.avatar;
                        has-image: root.message.has-avatar;
                        url: root.message.avatar-url;
                        initials: root.message.initials;
                        fill-color: root.message.initials-color;
                        image-name: "msgAvatar";
                        placeholder-name: "msgAvatarPlaceholder";
                        initials-name: "msgAvatarInitials";
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-xs;

                    HorizontalLayout {
                        padding: Theme.spacing-none;
                        spacing: Theme.spacing-l;

                        Text {
                            accessible-id: "msgAuthor";
                            vertical-alignment: center;
                            color: Theme.text;
                            font-weight: Theme.font-weight-semibold;
                            overflow: elide;
                            text: root.message.author;
                        }

                        Text {
                            accessible-id: "msgTime";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: root.message.time;
                        }

                        if root.message.edited: Text {
                            accessible-id: "msgEdited";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: @tr("(edited)");
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        // Keeps its place the rest of the time, so the rows don't change height.
                        VerticalLayout {
                            alignment: center;
                            width: Theme.menu-button-width;
                            padding: Theme.spacing-none;
                            spacing: Theme.spacing-none;

                            menu-button := Rectangle {
                                accessible-id: "msgMenuButton";
                                accessible-role: button;
                                accessible-label: @tr("Message menu");
                                visible: root.message.has-menu;
                                height: Theme.menu-button-height;
                                opacity: row-touch.has-hover || button-touch.has-hover || menu.is-open ? Theme.opaque : Theme.clear;
                                background: Theme.raised;
                                border-color: Theme.raised-hover;
                                border-width: Theme.border-width;
                                border-radius: Theme.radius-control;

                                Text {
                                    color: button-touch.has-hover ? Theme.text : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: "\u{22EF}";
                                }

                                button-touch := TouchArea {
                                    clicked => {
                                        root.open-menu(menu-button.absolute-position.x - root.absolute-position.x, menu-button.absolute-position.y - root.absolute-position.y + menu-button.height);
                                    }
                                }
                            }
                        }

                        // These exist only while the message is in that state, so that a test can
                        // find the one unsent message without knowing its id.
                        if root.message.delivery == "pending": Text {
                            accessible-id: "msgPending";
                            vertical-alignment: center;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-tiny;
                            text: @tr("Sending…");
                        }

                        if root.message.delivery == "failed": Text {
                            accessible-id: "msgFailed";
                            vertical-alignment: center;
                            color: Theme.error;
                            font-size: Theme.font-size-tiny;
                            text: @tr("Not sent");
                        }

                        if root.message.delivery == "failed": FlatButton {
                            accessible-id: "msgRetry";
                            text: @tr("Retry");
                            clicked => {
                                root.retry(root.message.id);
                            }
                        }
                    }

                    // `accessible-value` is the message as written, which the tests read;
                    // `msgBodyHtml` is what is shown.
                    Rectangle {
                        accessible-id: "msgBody";
                        accessible-role: text;
                        accessible-value: root.message.body;
                        opacity: root.message.delivery == "sent" ? Theme.opaque : Theme.disabled-opacity;
                        preferred-height: body-text.preferred-height;

                        body-text := StyledText {
                            accessible-id: "msgBodyHtml";
                            accessible-role: text;
                            accessible-value: root.message.body-html;
                            x: Theme.spacing-none;
                            y: Theme.spacing-none;
                            width: root.body-width;
                            default-color: Theme.text;
                            default-font-size: root.message.big-emoji ? Theme.font-size-big-emoji : Theme.font-size-base;
                            link-color: Theme.own;
                            text: root.message.body-styled;
                            link-clicked(url) => {
                                root.open-link(url);
                            }
                        }
                    }
                }
            }
        }

        if root.message.is-system: HorizontalLayout {
            padding-left: Theme.spacing-xxxl;
            padding-right: Theme.spacing-xxxl;
            padding-top: Theme.message-padding-v;
            padding-bottom: Theme.message-padding-v;
            spacing: Theme.spacing-l;

            Text {
                accessible-id: "msgSystem";
                width: root.text-width - system-time.preferred-width - Theme.spacing-l;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
                text: root.message.system-text;
            }

            system-time := Text {
                color: Theme.text-faint;
                font-size: Theme.font-size-tiny;
                text: root.message.time;
            }
        }
    }

    // Opens at the pointer or under the button; Slint keeps it inside the window. The items
    // that don't apply are hidden with no height and not left out with `if`, which a click
    // would miss (SLINT.md). Quote, reaction and thread items go above Edit.
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: Theme.menu-width;
        height: items.preferred-height + 2 * Theme.border-width;

        Rectangle {
            background: Theme.raised;
            border-color: Theme.raised-hover;
            border-width: Theme.border-width;
            border-radius: Theme.radius-control;

            items := VerticalLayout {
                padding: Theme.menu-padding;
                spacing: Theme.spacing-none;

                MenuItem {
                    accessible-id: "msgEditAction";
                    visible: root.can-edit;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Edit");
                    triggered => {
                        menu.close();
                        root.edit(root.message.id);
                    }
                }

                MenuItem {
                    accessible-id: "msgDeleteAction";
                    visible: root.can-delete;
                    height: self.visible ? Theme.menu-item-height : Theme.spacing-none;
                    text: @tr("Delete");
                    triggered => {
                        menu.close();
                        root.delete(root.message.id);
                    }
                }
            }
        }
    }
}
