import { FlatButton } from "flat_button.slint";
import { PrimaryButton } from "primary_button.slint";
import { Theme } from "theme.slint";

// Asks the user to confirm something, over the whole window, which it dims and blocks while it is
// shown. Escape cancels, as in the QML app's dialogs. The caller names the question, the buttons
// and their accessible ids.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> question;
    in property <string> confirm-text;
    in property <string> question-id;
    in property <string> confirm-id;
    in property <string> cancel-id;
    callback confirmed();
    callback cancelled();

    background: Theme.modal-dim;

    // Takes the clicks that would reach the window, and the keys.
    scope := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }

        TouchArea { }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.dialog-width;
        height: content.preferred-height + 2 * Theme.border-width;
        background: Theme.raised;
        border-color: Theme.raised-hover;
        border-width: Theme.border-width;
        border-radius: Theme.radius-control;

        content := VerticalLayout {
            padding: Theme.dialog-padding;
            spacing: Theme.spacing-xl;

            Text {
                color: Theme.text;
                font-size: Theme.font-size-base;
                font-weight: Theme.font-weight-bold;
                text: root.title;
            }

            Text {
                accessible-id: root.question-id;
                color: Theme.text;
                wrap: word-wrap;
                text: root.question;
            }

            // The buttons share the width, the main one first, as in the QML app's dialog.
            HorizontalLayout {
                spacing: Theme.spacing-m;

                PrimaryButton {
                    accessible-id: root.confirm-id;
                    horizontal-stretch: 1;
                    text: root.confirm-text;
                    clicked => {
                        root.confirmed();
                    }
                }

                FlatButton {
                    accessible-id: root.cancel-id;
                    horizontal-stretch: 1;
                    text: @tr("Cancel");
                    clicked => {
                        root.cancelled();
                    }
                }
            }
        }
    }
}
