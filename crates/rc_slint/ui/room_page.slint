import { Composer } from "composer.slint";
import { KindIcon } from "icon.slint";
import { FlatButton } from "flat_button.slint";
import { ListView } from "list_view.slint";
import { MessageList } from "message_list.slint";
import { RoomDelegate } from "room_delegate.slint";
import { RoomSearchField } from "room_search_field.slint";
import { RoomSearchResults } from "room_search_results.slint";
import { MessageMenu, MessageRow, RoomRow } from "structs.slint";
import { Theme } from "theme.slint";
import { TypingLine } from "typing_line.slint";

// The page of a logged-in account: the sidebar with the server, the user and the room list, and
// the open room beside it: its header, and its messages.
export component RoomPage inherits Rectangle {
    // Empty while the realtime connection is up.
    in property <string> connection-text;
    // The server without its scheme or path, and who is logged in there.
    in property <string> host;
    in property <string> username;
    // The room list, with the headings of its sections.
    in property <[RoomRow]> rooms;
    // The open room, empty for none: its name, its kind (the name of its icon) and its topic: the
    // text to show, and its HTML, which the GUI tests read (the contract with the QML app).
    in property <string> room-id;
    in property <string> room-name;
    in property <string> room-kind;
    in property <styled-text> room-topic;
    in property <string> room-topic-html;
    // Who is typing in the open room, as a line; empty for nobody.
    in property <string> typing;
    // The messages of the open room, oldest first, and what the list shows around them: whether the
    // conversation starts above them, whether older ones are loading, and the counters that the
    // list's view keeps its place by (see `message_list.slint`).
    in property <[MessageRow]> messages;
    in property <bool> reached-start;
    in property <bool> loading-older;
    in property <int> prepends;
    in property <int> resets;
    // Why the last command on a room failed; empty for none.
    in property <string> room-list-error;
    // The search: whether the query isn't empty, and then the query without the space around it
    // and the rooms that match, worst first (see `room_search_results.slint`), with a number that
    // goes up with each new result set.
    in property <bool> search-active;
    in property <string> search-trimmed;
    in property <[RoomRow]> search-results;
    in property <int> search-generation;
    callback search(string);
    callback open-room(string);
    // The room's menu: a favorite is set or taken back, the room is marked read or unread, or
    // leaving is asked for (the id and the name, for the dialog that asks).
    callback set-favorite(string, bool);
    callback mark-read(string);
    callback mark-unread(string);
    callback leave(string, string);
    callback dismiss-room-list-error();
    // Why the last edit, deletion or reaction of a message failed; empty for none.
    in property <string> room-action-error;
    callback dismiss-room-action-error();
    // The menu of a message: what it offers now, asked when it opens, and the user's choices.
    // Deleting is only asked for: the window asks the user first.
    callback menu-allowed(string) -> MessageMenu;
    callback delete-message(string);
    // The user clicked a chip of a message: add their reaction with the emoji, or take it back.
    callback react(string, string, bool);
    // The user wants to pick an emoji to react to the message with.
    callback add-reaction(string);
    // The composer edits a message: its text and the newest editable one are asked for, the new
    // text is saved, and the answer comes back as the counter going up (see `composer.slint`).
    callback message-text(string) -> string;
    callback message-author(string) -> string;
    callback last-editable() -> string;
    callback save-edit(string, string);
    in property <int> edit-answers;
    in property <string> edit-answer-id;
    in property <bool> edit-answer-ok;
    // The list of messages is at its top: older ones are wanted.
    callback load-older();
    // A link of the topic or of a message was clicked.
    callback open-link(string);
    // Sends the text to the open room; false if it refuses it, which leaves the composer as it is.
    callback send(string, string) -> bool;
    // Sends a message that failed to send again, by its id.
    callback retry(string);

    // Whether the composer is to take the focus when the room that is being opened shows, and how
    // many times it was asked to take it now.
    property <bool> composer-wanted;
    property <int> composer-requests;

    // The search is over: the field is emptied and gives up the focus, which goes to the composer
    // of the open room, or of the one being opened (`opened`, with its id), or to nothing.
    function leave-search(opened: bool, id: string) {
        search-field.clear-text();
        search-field.give-up-focus();
        if opened {
            root.composer-wanted = true;
        }
        if (opened && id == root.room-id) || (!opened && !root.room-id.is-empty) {
            root.composer-requests += 1;
        }
    }

    // Ctrl+K anywhere in the page focuses the search field. The key is a control character on some
    // platforms.
    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "\u{b}") {
                search-field.focus-field();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Theme.spacing-none;
            spacing: Theme.spacing-none;

            if !root.connection-text.is-empty: Rectangle {
                background: Theme.warning-wash;
                preferred-height: banner.preferred-height + 2 * Theme.spacing-m;
                max-height: self.preferred-height;

                banner := Text {
                    accessible-id: "connectionBanner";
                    x: Theme.spacing-m;
                    y: Theme.spacing-m;
                    width: parent.width - 2 * Theme.spacing-m;
                    color: Theme.warning;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: root.connection-text;
                }
            }

            HorizontalLayout {
                padding: Theme.spacing-none;
                spacing: Theme.spacing-none;

                VerticalLayout {
                    width: Theme.sidebar-width;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    // The server: its host, and who you are there.
                    VerticalLayout {
                        padding-left: Theme.sidebar-header-padding-h;
                        padding-right: Theme.sidebar-header-padding-h;
                        padding-top: Theme.spacing-xxl;
                        padding-bottom: Theme.spacing-xl;
                        spacing: Theme.spacing-xxs;

                        Text {
                            accessible-id: "serverName";
                            color: Theme.text;
                            font-size: Theme.font-size-heading;
                            font-weight: Theme.font-weight-bold;
                            overflow: elide;
                            text: root.host;
                        }

                        Text {
                            accessible-id: "serverUser";
                            color: Theme.text-faint;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                            text: root.username;
                        }
                    }

                    // One list, so that everything scrolls together: the favorites come first, and
                    // the headings of the sections are rows of it, there only while there are
                    // favorites.
                    Rectangle {
                        vertical-stretch: 1;

                        ListView {
                            accessible-id: "roomList";
                            accessible-role: list;
                            width: parent.width;
                            height: parent.height;
                            visible: !root.search-active;

                            for room in root.rooms: RoomDelegate {
                                room: room;
                                highlighted: room.id == root.room-id;
                                clicked => {
                                    root.open-room(room.id);
                                }
                                set-favorite(favorite) => {
                                    root.set-favorite(room.id, favorite);
                                }
                                mark-read => {
                                    root.mark-read(room.id);
                                }
                                mark-unread => {
                                    root.mark-unread(room.id);
                                }
                                leave => {
                                    root.leave(room.id, room.name);
                                }
                            }
                        }

                        // The rooms that match, in place of the list.
                        results := RoomSearchResults {
                            width: parent.width;
                            height: parent.height;
                            visible: root.search-active;
                            results: root.search-results;
                            generation: root.search-generation;
                            open-id: root.room-id;
                            clicked(id) => {
                                root.open-room(id);
                                root.leave-search(true, id);
                            }
                        }
                    }

                    // Why the last command on a room failed, until it is dismissed or the user
                    // tries again.
                    if !root.room-list-error.is-empty: Rectangle {
                        accessible-id: "roomListError";
                        accessible-role: groupbox;

                        HorizontalLayout {
                            padding: Theme.spacing-l;
                            spacing: Theme.spacing-l;

                            Text {
                                accessible-id: "roomListErrorText";
                                horizontal-stretch: 1;
                                color: Theme.error;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                text: root.room-list-error;
                            }

                            VerticalLayout {
                                alignment: center;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-none;

                                FlatButton {
                                    accessible-id: "roomListErrorDismiss";
                                    text: @tr("Dismiss");
                                    clicked => {
                                        root.dismiss-room-list-error();
                                    }
                                }
                            }
                        }
                    }

                    // Under the text of the field, just above it.
                    if root.search-active && root.search-results.length == 0: HorizontalLayout {
                        padding-left: Theme.room-row-inset + Theme.room-name-inset;
                        padding-right: Theme.room-row-inset + Theme.row-padding-h;
                        padding-top: Theme.spacing-none;
                        padding-bottom: Theme.spacing-none;
                        spacing: Theme.spacing-none;

                        Text {
                            accessible-id: "roomSearchEmpty";
                            accessible-role: text;
                            accessible-value: self.text;
                            color: Theme.text-faint;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                            text: @tr("No rooms match “{}”", root.search-trimmed);
                        }
                    }

                    // Searches the user's rooms by name. While it holds something, the results
                    // replace the list and pile up from here. The focus stays here while typing: Up
                    // and Down move through the results, away from the field and back. Enter, a
                    // click on a result and Escape clear the field and hand the focus on.
                    VerticalLayout {
                        padding-left: Theme.room-row-inset;
                        padding-right: Theme.room-row-inset;
                        padding-top: Theme.spacing-l;
                        padding-bottom: Theme.search-field-bottom-margin;
                        spacing: Theme.spacing-none;

                        search-field := RoomSearchField {
                            query-changed(query) => {
                                root.search(query);
                            }
                            changed focused => {
                                if self.focused {
                                    root.composer-wanted = false;
                                }
                            }
                            up => {
                                results.move-up();
                            }
                            down => {
                                results.move-down();
                            }
                            enter => {
                                // Nothing under the cursor opens nothing, and the search stays.
                                if root.search-active && root.search-results.length > 0 {
                                    let id = results.cursor-id();
                                    root.open-room(id);
                                    root.leave-search(true, id);
                                }
                            }
                            escape => {
                                root.leave-search(false, "");
                            }
                            init => {
                                // A page made again starts with an empty field, whatever was
                                // searched before.
                                root.search(self.text);
                            }
                        }
                    }
                }

                Rectangle {
                    width: Theme.separator-width;
                    background: Theme.line;
                }

                // The open room: its kind, its name and under it its topic, over a hairline.
                Rectangle {
                    background: Theme.surface;
                    horizontal-stretch: 1;

                    if !root.room-id.is-empty: Rectangle {
                        y: Theme.spacing-none;
                        height: Theme.room-header-height;

                        HorizontalLayout {
                            padding-left: Theme.spacing-xxxl;
                            padding-right: Theme.spacing-xxxl;
                            padding-top: Theme.spacing-none;
                            padding-bottom: Theme.spacing-none;
                            spacing: Theme.spacing-xl;

                            VerticalLayout {
                                alignment: center;
                                width: Theme.room-header-icon-size;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-none;

                                KindIcon {
                                    width: Theme.room-header-icon-size;
                                    height: Theme.room-header-icon-size;
                                    kind: root.room-kind;
                                    tint: Theme.own;
                                }
                            }

                            // Centred, so that the name of a room without a topic is in the middle.
                            VerticalLayout {
                                alignment: center;
                                padding: Theme.spacing-none;
                                spacing: Theme.spacing-xxs;

                                Text {
                                    accessible-id: "roomTitle";
                                    color: Theme.text;
                                    font-size: Theme.font-size-heading;
                                    font-weight: Theme.font-weight-bold;
                                    overflow: elide;
                                    text: root.room-name;
                                }

                                if !root.room-topic-html.is-empty: StyledText {
                                    accessible-id: "roomTopic";
                                    accessible-role: text;
                                    accessible-value: root.room-topic-html;
                                    default-color: Theme.text-muted;
                                    default-font-size: Theme.font-size-small;
                                    link-color: Theme.own;
                                    max-lines: 1;
                                    text: root.room-topic;
                                    link-clicked(url) => {
                                        root.open-link(url);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - self.height;
                            height: Theme.separator-width;
                            background: Theme.line;
                        }
                    }

                    // The messages, and the composer under them.
                    if !root.room-id.is-empty: VerticalLayout {
                        y: Theme.room-header-height;
                        width: parent.width;
                        height: parent.height - Theme.room-header-height;
                        padding: Theme.spacing-none;
                        spacing: Theme.spacing-none;

                        MessageList {
                            vertical-stretch: 1;
                            composer-wanted: root.composer-wanted;
                            messages: root.messages;
                            in-thread-pane: false;
                            room-id: root.room-id;
                            reached-start: root.reached-start;
                            loading-older: root.loading-older;
                            prepends: root.prepends;
                            resets: root.resets;
                            load-older => {
                                root.load-older();
                            }
                            retry(id) => {
                                root.retry(id);
                            }
                            open-link(url) => {
                                root.open-link(url);
                            }
                            menu-allowed(id) => {
                                return root.menu-allowed(id);
                            }
                            quote(id) => {
                                composer.begin-quote(id);
                            }
                            edit(id) => {
                                composer.begin-edit(id);
                            }
                            delete(id) => {
                                root.delete-message(id);
                            }
                            react(id, emoji, reacted) => {
                                root.react(id, emoji, reacted);
                            }
                            add-reaction(id) => {
                                root.add-reaction(id);
                            }
                        }

                        // Why the last edit, deletion or reaction failed, until it is dismissed or the user
                        // tries again.
                        if !root.room-action-error.is-empty: Rectangle {
                            accessible-id: "roomActionError";
                            accessible-role: groupbox;

                            HorizontalLayout {
                                padding: Theme.spacing-l;
                                spacing: Theme.spacing-l;

                                Text {
                                    accessible-id: "roomActionErrorText";
                                    horizontal-stretch: 1;
                                    color: Theme.error;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    text: root.room-action-error;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    padding: Theme.spacing-none;
                                    spacing: Theme.spacing-none;

                                    FlatButton {
                                        accessible-id: "roomActionErrorDismiss";
                                        text: @tr("Dismiss");
                                        clicked => {
                                            root.dismiss-room-action-error();
                                        }
                                    }
                                }
                            }
                        }

                        // Empty most of the time, but its height is always taken.
                        HorizontalLayout {
                            padding-left: Theme.spacing-xxxl;
                            padding-right: Theme.spacing-xxxl;
                            padding-top: Theme.spacing-none;
                            padding-bottom: Theme.spacing-none;
                            spacing: Theme.spacing-none;

                            TypingLine {
                                accessible-id: "roomTyping";
                                text: root.typing;
                            }
                        }

                        HorizontalLayout {
                            padding-left: Theme.spacing-xxxl;
                            padding-right: Theme.spacing-xxxl;
                            padding-top: Theme.spacing-m;
                            padding-bottom: Theme.spacing-xxxl;
                            spacing: Theme.spacing-none;

                            composer := Composer {
                                edit-answers: root.edit-answers;
                                edit-answer-id: root.edit-answer-id;
                                edit-answer-ok: root.edit-answer-ok;
                                focus-wanted: root.composer-wanted;
                                focus-requests: root.composer-requests;
                                room-id: root.room-id;
                                focused => {
                                    root.composer-wanted = false;
                                }
                                send(text, quoted) => {
                                    return root.send(text, quoted);
                                }
                                save-edit(id, text) => {
                                    root.save-edit(id, text);
                                }
                                message-text(id) => {
                                    return root.message-text(id);
                                }
                                message-author(id) => {
                                    return root.message-author(id);
                                }
                                last-editable => {
                                    return root.last-editable();
                                }
                            }
                        }
                    }

                    if root.room-id.is-empty: Text {
                        accessible-id: "roomPlaceholder";
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: @tr("Select a room");
                    }
                }
            }
        }
    }
}
