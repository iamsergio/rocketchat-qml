// What Rust tells the GUI, as the views of `rc_view` give it.

// Where the session is. Mirrors `rc_view::session_view::Status`.
export enum SessionStatus {
    unknown,
    logged-out,
    connecting,
    resuming,
    logged-in,
}

// What the login page is for. Mirrors `rc_view::session_view::LoginMode`.
export enum LoginMode {
    login,
    adding,
    again,
}

// One tile of the rail: an `rc_view::accounts::AccountView`.
export struct AccountTile {
    id: string,
    // The letter of the tile.
    monogram: string,
    // What the tile is called for accessibility.
    label: string,
    // A new account, nobody logged in: its tile is a dashed plus.
    fresh: bool,
    // The account on screen.
    current: bool,
    // Some room is unread, and the account is not on screen.
    unread: bool,
    // Connecting or resuming.
    busy: bool,
    // The login ended.
    expired: bool,
    mentions: int,
}

// What a row of the room list is: a room, or the heading of a section.
export enum RoomSection {
    room,
    favorites,
    rooms,
}

// One row of the room list: a room, or the heading of a section (nothing else is set then).
export struct RoomRow {
    section: RoomSection,
    id: string,
    name: string,
    // `channel`, `private` or `direct`.
    kind: string,
    unread: int,
    // The mention badge; none for zero.
    mentions: int,
    // The room has something new for the user, which its name shows.
    has-unread: bool,
    // The room is one of the user's favorites, and the user can leave it (not a direct message):
    // what its menu offers.
    favorite: bool,
    can-leave: bool,
    // The initials and the colour behind them, shown while there is no avatar image.
    initials: string,
    initials-color: color,
    // The `file://` URL of the avatar file; empty for none.
    avatar-url: string,
    // Whether `avatar` holds an image.
    has-avatar: bool,
    avatar: image,
}

// One row of the list of a room's threads: the parent of a thread, as `rc_view::thread_list_view`
// and `message_view` say it. The marks of a thread with unread replies (`unread`, `mentioned`)
// will be two more fields (ACT-011).
export struct ThreadRow {
    // The id of the parent, which names the row.
    id: string,
    author: string,
    // The time of the last reply, or the heading of its day.
    last-reply: string,
    // The start of the parent's text, on one line: the row clamps it to two.
    text: string,
    // "N replies".
    summary: string,
    // The author's avatar, as the room list has it.
    initials: string,
    initials-color: color,
    avatar-url: string,
    has-avatar: bool,
    avatar: image,
    // The thread has replies the user hasn't read, and one of them mentions the user.
    unread: bool,
    mentioned: bool,
}

// What the pane beside the room shows besides the thread itself: the `rc_view::thread_list_view`
// `ThreadListState`.
export struct ThreadPaneState {
    // The pane shows something: the thread, or else the list.
    open: bool,
    shows-thread: bool,
    shows-list: bool,
    // `all`, `following` or `unread`.
    filter: string,
    loading: bool,
    loading-more: bool,
    // Why the last request failed; empty for none.
    error-text: string,
    // The list is open and has nothing to show, and the words that say so.
    empty: bool,
    empty-title: string,
    empty-hint: string,
    // How many threads of the room have replies the user hasn't read, and one mentions the user:
    // the badge of the header button and the count of the "Unread" segment.
    unread-count: int,
    unread-mention: bool,
}

// One message quoted by a message: an `rc_view::quote_view::QuoteView`.
export struct QuoteRow {
    // The username of the quoted message's author.
    author: string,
    // The time of day it was sent; empty if unknown.
    time: string,
    // What it said as written, and as the HTML that the GUI tests read.
    body: string,
    body-html: string,
    // What it said as the styled text that is shown.
    body-styled: styled-text,
}

// One file attached to a message: an `rc_view::attachment_view::AttachmentView`, as drawn.
export struct AttachmentRow {
    title: string,
    description: string,
    // For example `1.5 KB`; empty when the server didn't say.
    size: string,
    // The address of the original on the server, which a click opens.
    link: string,
    is-image: bool,
    // The `file://` URL of the image's file, which the GUI tests read; empty while there is none.
    image-url: string,
    // Whether `image` holds the picture.
    has-image: bool,
    image: image,
    // The picture's size in pixels; 0 when the server didn't say.
    width: int,
    height: int,
}

// One reaction of a message: an `rc_view::reaction_view::ReactionView`, as drawn.
export struct ReactionRow {
    // The shortcode as the server has it, colons included: what reacting again sends.
    emoji: string,
    // What the GUI tests read: the glyph, else the server's address of the custom emoji's image,
    // else the shortcode.
    label: string,
    // What is drawn as text: the glyph, or the shortcode while a custom emoji has no file.
    text: string,
    // Whether `image` holds the custom emoji's picture, which is drawn instead of the text.
    has-image: bool,
    image: image,
    count: int,
    // The user is one of those who reacted.
    mine: bool,
}

// One message of the open room: an `rc_view` message list's row, as `rc_qt`'s roles give it.
export struct MessageRow {
    id: string,
    author: string,
    // The time of day.
    time: string,
    // The message as written, and as the HTML that the GUI tests read.
    body: string,
    body-html: string,
    // The body as the styled text that is shown, and whether it is only emoji, which is shown larger.
    body-styled: styled-text,
    big-emoji: bool,
    // A system message shows `system-text` instead of an author and a body.
    is-system: bool,
    system-text: string,
    // The first message of its day shows the heading `day-label` above it.
    first-of-day: bool,
    day-label: string,
    // The message was edited.
    edited: bool,
    // The message mentions the user.
    mentions-me: bool,
    // What the message quotes, in order. Most have none, and then no model is made.
    quotes: [QuoteRow],
    // The files attached, in order. Most messages have none, and then no model is made.
    attachments: [AttachmentRow],
    // What users reacted with, in the server's order. Most messages have none, and then no model
    // is made. `can-react`: the user can add or take back a reaction by clicking a chip.
    reactions: [ReactionRow],
    can-react: bool,
    // The body has a link. Its text takes every click then, so that a double-click on it can't
    // reach the message behind (see `message_delegate.slint`).
    has-links: bool,
    // The message had a menu when the row was made (the user could quote, edit or delete it):
    // the button shows and a right-click opens. What the menu offers is asked for when it opens,
    // since the time limits of the server's policy run out.
    has-menu: bool,
    // A sent text message that is not a reply can start a thread: the menu offers it, and has
    // something to offer for that alone.
    can-start-thread: bool,
    // As the parent of a thread: how many replies it has, and when the last came (a time of day or
    // the heading of its day; empty without replies).
    thread-replies: int,
    thread-last-reply: string,
    // As a reply: the id of its parent, else empty. A reply also sent to the room, in the room, has
    // a line that leads to its thread, with the start of the parent's text if the room holds it.
    thread-id: string,
    in-thread-shown: bool,
    thread-parent-text: string,
    // `sent`, `pending` or `failed`.
    delivery: string,
    // The author's avatar, as the room list has it.
    initials: string,
    initials-color: color,
    avatar-url: string,
    has-avatar: bool,
    avatar: image,
}

// What the menu of a message offers now, from the `menu-allowed` callback.
export struct MessageMenu {
    can-quote: bool,
    can-react: bool,
    can-edit: bool,
    can-delete: bool,
}

// One emoji of the picker. `name` is the shortcode without its colons, which names the cell for the
// GUI tests; `emoji` is the shortcode with them, which a reaction is made of. A custom emoji has
// `has-image` once its file is there, and shows its `name` until then.
export struct EmojiCell {
    name: string,
    emoji: string,
    glyph: string,
    has-image: bool,
    image: image,
}
