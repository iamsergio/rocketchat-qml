import { FlatButton } from "flat_button.slint";
import { Icon } from "icon.slint";
import { PrimaryButton } from "primary_button.slint";
import { Theme } from "theme.slint";

// The box under the messages of the open room. Enter sends, Shift+Enter starts a new line. The
// field grows with its text up to a height, then scrolls.
//
// It also edits a message of the user's: `begin-edit` puts the message's text in the field, a bar
// above it says so, and Enter saves instead of sending. Escape, the bar's button or another room
// ends it, and the draft that was in the field comes back; so does a saved edit.
//
// And it quotes a message: `begin-quote` shows a bar above the field with the author and a line of
// the text, and sending passes the message's id. Sending, Escape, the bar's button and another room
// drop the quote. Quoting and editing exclude each other.
//
// The composer of the thread pane is the same box (`for-thread`), with its own field, bars and
// callbacks: the caller wires them to the thread.
export component Composer inherits Rectangle {
    // The box writes in the open thread and not in the room. Under the text it has a check box,
    // off for each reply, that also sends the reply to the room (`room-name`, for its label), and
    // Escape with nothing to cancel is for the caller (`escape`).
    in property <bool> for-thread;
    // The room is a channel previewed without being in it: the box offers to join in Send's place,
    // and what is typed waits in the field. `joining` while the join is under way.
    in property <bool> preview;
    in property <bool> joining;
    callback join();
    in property <string> room-name;
    out property <bool> also-to-channel;
    callback escape();
    // Sends the text, quoting the message with the id (empty for none); false if it is refused,
    // which leaves the field as it is.
    callback send(string, string) -> bool;
    // The search field hands the focus on: to this composer when it is made or when the room
    // changes while `focus-wanted`, and at once when `focus-requests` goes up. `focused` says that
    // the composer has it, so that the wish is over.
    in property <bool> focus-wanted;
    in property <int> focus-requests;
    // The conversation it writes in: the room, or for a thread its parent. Another one drops what
    // was started for the last one.
    in property <string> conversation-id;
    callback focused();
    // Saves the text as the new text of the message with this id. The answer comes as
    // `edit-answers` going up.
    callback save-edit(string, string);
    // The text of a message as written, and the id of the newest one that can be edited now (both
    // empty if there is none).
    callback message-text(string) -> string;
    // Who wrote a message as the quote bar names them, empty if it isn't known.
    callback message-author(string) -> string;
    callback last-editable() -> string;
    // The answer to the last edit: how many there have been, which message it was about and
    // whether it worked. A failure stays in edit mode, with the text.
    in property <int> edit-answers;
    in property <string> edit-answer-id;
    in property <bool> edit-answer-ok;

    // The message being edited, or empty when the box writes a new message.
    property <string> editing-id;
    // The text that was in the field when editing began.
    property <string> draft;
    // The edit was sent and the answer is awaited.
    property <bool> saving;
    property <bool> editing: root.editing-id != "";
    // The message being quoted, or empty, with what the bar shows of it.
    property <string> quoting-id;
    property <string> quoted-author;
    property <string> quoted-text;
    property <bool> quoting: root.quoting-id != "";
    // The check box: as tall as its label or its box, with the space under it.
    property <length> also-height: max(Theme.check-box-size, Theme.font-size-small * Theme.line-height-scale) + Theme.spacing-l;
    // The edit bar: its row and the line under it.
    property <length> bar-height: Theme.button-height + 2 * Theme.spacing-l + Theme.separator-width;
    // The quote bar: the author over a line of text, or the button if that is taller.
    property <length> quote-lines-height: 2 * Theme.font-size-small * Theme.line-height-scale + Theme.spacing-xxs;
    property <length> quote-bar-height: max(root.quote-lines-height, Theme.button-height) + 2 * Theme.spacing-l + Theme.separator-width;
    // A position past any text: the cursor goes to the end.
    property <int> end-of-text: 2147483647;

    // The field: its text with the space above and below it, between the least and the most.
    property <length> field-height: clamp(
        input.height + 2 * Theme.text-area-padding-v,
        Theme.composer-field-min-height,
        Theme.composer-max-height);

    function submit() {
        if root.preview {
            return;
        }
        if root.editing {
            root.save();
        } else if root.send(input.text, root.quoting-id) {
            input.text = "";
            root.drop-quote();
            root.also-to-channel = false;
        }
    }

    // Starts quoting a message of the open room, ending an edit first. Nothing happens if the
    // message isn't known.
    public function begin-quote(id: string) {
        let author = root.message-author(id);
        if author.is-empty {
            return;
        }
        if root.editing {
            root.end-edit();
        }
        root.quoting-id = id;
        root.quoted-author = author;
        root.quoted-text = root.message-text(id);
        input.focus();
    }

    function drop-quote() {
        root.quoting-id = "";
        root.quoted-author = "";
        root.quoted-text = "";
    }

    // Stops quoting and gives the field the focus back.
    function end-quote() {
        root.drop-quote();
        input.focus();
    }

    function save() {
        if root.saving || input.text.is-empty {
            return;
        }
        root.saving = true;
        root.save-edit(root.editing-id, input.text);
    }

    // Starts editing a message of the open room. Nothing happens if its text isn't known.
    public function begin-edit(id: string) {
        let text = root.message-text(id);
        if text.is-empty {
            return;
        }
        if !root.editing {
            root.draft = input.text;
        }
        root.drop-quote();
        root.editing-id = id;
        root.saving = false;
        input.text = text;
        input.focus();
        input.set-selection-offsets(root.end-of-text, root.end-of-text);
    }

    // Leaves edit mode and puts the draft back.
    function end-edit() {
        root.editing-id = "";
        root.saving = false;
        input.text = root.draft;
        root.draft = "";
        input.focus();
    }

    init => {
        if root.focus-wanted {
            input.focus();
        }
    }
    changed conversation-id => {
        if root.editing {
            root.end-edit();
        }
        root.drop-quote();
        root.also-to-channel = false;
        if root.focus-wanted {
            input.focus();
        }
    }
    changed focus-requests => {
        input.focus();
    }
    changed edit-answers => {
        // Answers about other messages (a race) are none of this edit's.
        if root.editing && root.edit-answer-id == root.editing-id {
            if root.edit-answer-ok {
                root.end-edit();
            } else {
                root.saving = false;
            }
        }
    }

    // Its height follows the text, and it never takes more: the extra goes to the messages above.
    min-height: root.preferred-height;
    preferred-height: root.field-height + 2 * Theme.spacing-l + 2 * Theme.border-width + (root.editing ? root.bar-height : Theme.spacing-none) + (root.quoting ? root.quote-bar-height : Theme.spacing-none) + (root.for-thread ? root.also-height : Theme.spacing-none);
    vertical-stretch: 0;
    background: Theme.raised;
    border-width: Theme.border-width;
    border-color: input.has-focus ? Theme.own-border : Theme.raised-hover;
    border-radius: Theme.radius-panel;

    // Inside the border.
    VerticalLayout {
        padding: Theme.border-width;
        spacing: Theme.spacing-none;

        // Over a line.
        if root.quoting: Rectangle {
            accessible-id: "composerQuoteBar";
            accessible-role: groupbox;
            height: root.quote-bar-height;

            HorizontalLayout {
                y: Theme.spacing-none;
                height: parent.height - Theme.separator-width;
                padding-left: Theme.composer-padding-h;
                padding-right: Theme.spacing-xl;
                padding-top: Theme.spacing-l;
                padding-bottom: Theme.spacing-l;
                spacing: Theme.spacing-xl;

                Rectangle {
                    width: Theme.quote-bar-width;
                    background: Theme.own;
                    border-radius: Theme.quote-bar-width;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-xxs;

                    Text {
                        accessible-id: "composerQuoteAuthor";
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: Theme.font-weight-semibold;
                        overflow: elide;
                        text: root.quoted-author;
                    }

                    // The text as written is the element's, whole; only its first line shows.
                    Rectangle {
                        accessible-id: "composerQuoteText";
                        accessible-role: text;
                        accessible-value: root.quoted-text;
                        clip: true;
                        height: Theme.font-size-small * Theme.line-height-scale;

                        Text {
                            x: Theme.spacing-none;
                            y: Theme.spacing-none;
                            width: parent.width;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                            text: root.quoted-text;
                        }
                    }
                }

                FlatButton {
                    accessible-id: "composerQuoteCancel";
                    text: @tr("Cancel");
                    clicked => {
                        root.end-quote();
                    }
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: Theme.separator-width;
                background: Theme.raised-hover;
            }
        }

        if root.editing: Rectangle {
            accessible-id: "composerEditBar";
            accessible-role: groupbox;
            height: root.bar-height;

            HorizontalLayout {
                y: Theme.spacing-none;
                height: parent.height - Theme.separator-width;
                padding-left: Theme.composer-padding-h;
                padding-right: Theme.spacing-xl;
                padding-top: Theme.spacing-l;
                padding-bottom: Theme.spacing-l;
                spacing: Theme.spacing-xl;

                Rectangle {
                    width: Theme.quote-bar-width;
                    background: Theme.own;
                    border-radius: Theme.quote-bar-width;
                }

                Text {
                    horizontal-stretch: 1;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    text: @tr("Editing message");
                }

                FlatButton {
                    accessible-id: "composerEditCancel";
                    text: @tr("Cancel");
                    clicked => {
                        root.end-edit();
                    }
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: Theme.separator-width;
                background: Theme.raised-hover;
            }
        }

        HorizontalLayout {
            padding-left: Theme.composer-padding-h;
            padding-right: Theme.spacing-l;
            padding-top: Theme.spacing-l;
            padding-bottom: Theme.spacing-l;
            spacing: Theme.spacing-m;

            // Enter is taken before the text input, which would start a line with it.
            FocusScope {
                horizontal-stretch: 1;
                capture-key-pressed(event) => {
                    if event.text == Key.Return && !event.modifiers.shift {
                        root.submit();
                        return accept;
                    }
                    if event.text == Key.Escape && (root.editing || root.quoting) {
                        if root.editing {
                            root.end-edit();
                        } else {
                            root.end-quote();
                        }
                        return accept;
                    }
                    if event.text == Key.Escape && root.for-thread {
                        root.escape();
                        return accept;
                    }
                    // Up in an empty box edits the user's newest message.
                    if event.text == Key.UpArrow && !root.editing && input.text.is-empty {
                        let id = root.last-editable();
                        if !id.is-empty {
                            root.begin-edit(id);
                        }
                        return accept;
                    }
                    return reject;
                }

                field := Flickable {
                    content-width: self.width;
                    content-height: input.height + 2 * Theme.text-area-padding-v;
                    interactive: false;

                    input := TextInput {
                        accessible-id: "composerField";
                        x: Theme.spacing-none;
                        y: Theme.text-area-padding-v;
                        width: field.width;
                        height: self.preferred-height;
                        color: Theme.text;
                        font-size: Theme.font-size-base;
                        wrap: word-wrap;
                        single-line: false;
                        read-only: root.saving;
                        changed has-focus => {
                            if self.has-focus && root.focus-wanted {
                                root.focused();
                            }
                        }
                        cursor-position-changed(position) => {
                            // Keeps the line with the cursor in view.
                            let line = Theme.font-size-base * Theme.line-height-scale;
                            let top = position.y;
                            let bottom = position.y + line + 2 * Theme.text-area-padding-v;
                            if -field.content-y > top {
                                field.content-y = -top;
                            } else if bottom - field.content-y > field.height {
                                field.content-y = field.height - bottom;
                            }
                        }
                    }
                }

                Text {
                    color: Theme.text-faint;
                    font-size: Theme.font-size-base;
                    text: root.for-thread ? @tr("Reply in the thread") : @tr("Message");
                    x: Theme.spacing-none;
                    y: Theme.text-area-padding-v;
                    horizontal-alignment: left;
                    visible: input.text.is-empty;
                }
            }

            // Aligned to the bottom, whatever the height of the field. A plain rectangle and not a
            // layout: a layout would pass the button's fixed height up as the composer's largest.
            Rectangle {
                width: send-button.min-width;

                send-button := PrimaryButton {
                    accessible-id: root.preview ? "composerJoin" : "composerSend";
                    y: parent.height - self.height;
                    text: root.preview ? (root.joining ? @tr("Joining…") : @tr("Join")) : root.editing ? @tr("Save") : @tr("Send");
                    enabled: root.preview ? !root.joining : !input.text.is-empty && !root.saving;
                    clicked => {
                        if root.preview {
                            root.join();
                        } else {
                            root.submit();
                        }
                    }
                }
            }
        }

        // Under the text, inside the box: also shows the reply in the room. As wide as its text
        // and no wider than the box, since the room's name may be long.
        if root.for-thread: HorizontalLayout {
            padding-left: Theme.composer-padding-h;
            padding-right: Theme.composer-padding-h;
            padding-top: Theme.spacing-none;
            padding-bottom: Theme.spacing-l;
            spacing: Theme.spacing-none;
            alignment: start;

            Rectangle {
                accessible-id: "composerAlsoToChannel";
                accessible-role: checkbox;
                accessible-checkable: true;
                accessible-checked: root.also-to-channel;
                accessible-label: @tr("Also send to #{}", root.room-name);
                accessible-action-default => {
                    root.also-to-channel = !root.also-to-channel;
                }
                height: max(Theme.check-box-size, also-row.preferred-height);
                min-width: Theme.check-box-size;
                preferred-width: Theme.check-box-size + Theme.spacing-l + also-row.preferred-width;
                horizontal-stretch: 0;

                Rectangle {
                    x: Theme.spacing-none;
                    y: (parent.height - self.height) / 2;
                    width: Theme.check-box-size;
                    height: Theme.check-box-size;
                    background: root.also-to-channel ? Theme.own : Theme.surface;
                    border-color: root.also-to-channel ? Theme.own : Theme.raised-hover;
                    border-width: Theme.border-width;
                    border-radius: Theme.radius-check-box;

                    if root.also-to-channel: Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: Theme.check-mark-size;
                        height: Theme.check-mark-size;
                        source: @image-url("../../../src/gui/icons/check.svg");
                        tint: Theme.text-on-own;
                    }
                }

                also-row := HorizontalLayout {
                    x: Theme.check-box-size + Theme.spacing-l;
                    width: parent.width - self.x;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-s;

                    Text {
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        text: @tr("Also send to");
                    }

                    Text {
                        horizontal-stretch: 1;
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: Theme.font-weight-semibold;
                        overflow: elide;
                        vertical-alignment: center;
                        text: "#" + root.room-name;
                    }
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.also-to-channel = !root.also-to-channel;
                    }
                }
            }
        }
    }
}
