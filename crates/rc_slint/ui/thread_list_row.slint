import { Avatar } from "avatar.slint";
import { Icon } from "icon.slint";
import { ThreadRow } from "structs.slint";
import { Theme } from "theme.slint";

// One thread of the list: who started it and when it last had a reply, the start of what they
// wrote, clamped to two lines, and how many replies it has. Named by the parent's id, as messages
// are. Clicking it opens the thread in the pane.
//
// A row is as high as its content: one or two lines of text. A thread with unread replies has its
// text lit and the marks "New" and, if one of them mentions the user, "@" at the end of the last
// line.
export component ThreadListRow inherits Rectangle {
    in property <ThreadRow> thread;
    callback clicked();

    accessible-id: "threadListRow_" + root.thread.id;
    accessible-role: button;
    accessible-label: root.thread.text;
    accessible-action-default => {
        root.clicked();
    }

    height: content.preferred-height;
    background: touch.has-hover ? Theme.raised : Theme.transparent;

    content := HorizontalLayout {
        padding-left: Theme.spacing-xxxl;
        padding-right: Theme.spacing-xxxl;
        padding-top: Theme.spacing-xl;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-xl;

        VerticalLayout {
            alignment: start;
            width: Theme.thread-row-avatar-size;
            padding: Theme.spacing-none;
            spacing: Theme.spacing-none;

            Avatar {
                width: Theme.thread-row-avatar-size;
                height: Theme.thread-row-avatar-size;
                source: root.thread.avatar;
                has-image: root.thread.has-avatar;
                url: root.thread.avatar-url;
                initials: root.thread.initials;
                fill-color: root.thread.initials-color;
                image-name: "threadListAvatar";
                placeholder-name: "threadListAvatarPlaceholder";
                initials-name: "threadListAvatarInitials";
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.spacing-none;
            spacing: Theme.spacing-s;

            HorizontalLayout {
                padding: Theme.spacing-none;
                spacing: Theme.spacing-l;

                Text {
                    accessible-id: "threadListAuthor";
                    horizontal-stretch: 1;
                    color: Theme.text;
                    font-weight: Theme.font-weight-semibold;
                    overflow: elide;
                    text: root.thread.author;
                }

                Text {
                    accessible-id: "threadListTime";
                    color: Theme.text-faint;
                    font-size: Theme.font-size-tiny;
                    text: root.thread.last-reply;
                }
            }

            // Wrapped at an explicit width: a layout can't tell a wrapped text its height otherwise.
            Text {
                accessible-id: "threadListText";
                width: root.width - 2 * Theme.spacing-xxxl - Theme.thread-row-avatar-size - Theme.spacing-xl;
                color: root.thread.unread ? Theme.text : Theme.text-muted;
                font-weight: root.thread.unread ? Theme.font-weight-medium : Theme.font-weight-normal;
                max-lines: Theme.thread-row-text-lines;
                overflow: elide;
                wrap: word-wrap;
                text: root.thread.text;
            }

            HorizontalLayout {
                padding: Theme.spacing-none;
                spacing: Theme.spacing-m;

                VerticalLayout {
                    alignment: center;
                    width: Theme.thread-summary-icon-size;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    Icon {
                        width: Theme.thread-summary-icon-size;
                        height: Theme.thread-summary-icon-size;
                        source: @image-url("../../../src/gui/icons/thread.svg");
                        tint: Theme.own;
                    }
                }

                Text {
                    accessible-id: "threadListSummary";
                    horizontal-stretch: 1;
                    color: Theme.own;
                    font-size: Theme.font-size-small;
                    overflow: elide;
                    text: root.thread.summary;
                }

                // The server says which threads are unread, not how many replies are.
                if root.thread.unread: VerticalLayout {
                    alignment: center;
                    width: max(new-label.preferred-width + Theme.badge-padding-h, Theme.unread-badge-min-width);
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    Rectangle {
                        accessible-id: "threadListNew";
                        accessible-role: text;
                        accessible-value: new-label.text;
                        height: Theme.unread-badge-height;
                        background: Theme.raised-hover;
                        border-radius: self.height / 2;

                        new-label := Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            color: Theme.text;
                            font-size: Theme.font-size-tiny;
                            font-weight: Theme.font-weight-bold;
                            text: @tr("New");
                        }
                    }
                }

                // A reply that mentions the user.
                if root.thread.mentioned: VerticalLayout {
                    alignment: center;
                    width: Theme.unread-badge-min-width;
                    padding: Theme.spacing-none;
                    spacing: Theme.spacing-none;

                    Rectangle {
                        accessible-id: "threadListMention";
                        accessible-role: text;
                        accessible-value: "@";
                        height: Theme.unread-badge-height;
                        background: Theme.signal;
                        border-radius: self.height / 2;

                        Text {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            color: Theme.text-on-signal;
                            font-size: Theme.font-size-tiny;
                            font-weight: Theme.font-weight-bold;
                            text: "@";
                        }
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}
