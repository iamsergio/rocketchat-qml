[submodule "3rdparty/QtCommander"]
	path = 3rdparty/QtCommander
	url = ssh://git@projects.kdab.com:222/KDAB/QtCommander.git
	# Private, development-only (MCP server for agents). Fetch it explicitly with
	# git submodule update --init --checkout 3rdparty/QtCommander
	update = none
[submodule "3rdparty/spix"]
	path = 3rdparty/spix
	url = https://github.com/iamsergio/spix.git
[submodule "3rdparty/corrosion"]
	path = 3rdparty/corrosion
	url = https://github.com/corrosion-rs/corrosion.git
[submodule "3rdparty/cxx-qt-cmake"]
	path = 3rdparty/cxx-qt-cmake
	url = https://github.com/KDAB/cxx-qt-cmake.git
[submodule "3rdparty/vcpkg"]
	path = 3rdparty/vcpkg
	url = https://github.com/iamsergio/vcpkg.git
